# Photos uploaded through the admin panel. Never execute anything from here.
Options -Indexes -ExecCGI
<FilesMatch "\.(php|phtml|php[0-9]|phar|cgi|pl|py|sh)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
